<?xml version="1.0" encoding="utf-8"?>
<!--
═══════════════════════════════════════════════════════════════════════
  ФУТУРИСТИЧНЫЙ ИНЖЕНЕРНЫЙ UI - СТИЛЬ TONY STARK / CYBERPUNK
═══════════════════════════════════════════════════════════════════════

ЦВЕТОВАЯ СХЕМА:
  • Основной: Electric Cyan (#00F5FF, #00BCD4)
  • Акцент: Neon Orange (#FF6B35, #FF8C42)
  • Фон: Deep Space (#050A0F, #0A1520)
  • Текст: Bright White (#FFFFFF, #E0E0E0)
  • Danger: Red Alert (#FF3838, #E31E24)
  • Success: Matrix Green (#00FF88, #00E676)

ПРИНЦИПЫ ДИЗАЙНА:
  ✓ Минимализм и чёткость линий
  ✓ Монолитность шрифта (monospace)
  ✓ Прозрачные панели с размытием
  ✓ Анимации появления/исчезновения
  ✓ Цветовая индикация состояний
  ✓ Сетка и направляющие линии
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF050A0F"
    tools:context=".MainActivity">

    <!--═════════════════════════════════════════════════════════════════════-->
    <!-- AR VIEWPORT — полный экран, всё остальное поверх -->
    <!--═════════════════════════════════════════════════════════════════════-->
    <com.google.ar.sceneform.ArSceneView
        android:id="@+id/sceneView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!--═════════════════════════════════════════════════════════════════════-->
    <!-- GRID OVERLAY -->
    <!--═════════════════════════════════════════════════════════════════════-->
    <View
        android:id="@+id/view_grid_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/grid_overlay"
        android:alpha="0.15" />

    <!--═════════════════════════════════════════════════════════════════════-->
    <!-- TOP HUD BAR — фиксированная высота 56dp, чёткие 3 колонки -->
    <!--═════════════════════════════════════════════════════════════════════-->
    <LinearLayout
        android:id="@+id/top_hud_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_top_bar"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:elevation="8dp">

        <!-- LEFT: System Status -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/status_indicator"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/ic_status_dot_cyan"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/tv_system_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SYSTEM ONLINE"
                    android:textColor="#FF00F5FF"
                    android:textSize="10sp"
                    android:letterSpacing="0.12"
                    android:fontFamily="monospace"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_frame_counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FRM:0000"
                android:textColor="#6600F5FF"
                android:textSize="8sp"
                android:letterSpacing="0.08"
                android:fontFamily="monospace"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <!-- CENTER: Title -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▸ СТРУКТУРНЫЙ АНАЛИЗ ◂"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.2"
                android:fontFamily="monospace"
                android:singleLine="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI-POWERED ANALYSIS ENGINE"
                android:textColor="#5500F5FF"
                android:textSize="7sp"
                android:letterSpacing="0.12"
                android:fontFamily="monospace"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <!-- RIGHT: Session Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SESS 001"
                android:textColor="#6600F5FF"
                android:textSize="9sp"
                android:letterSpacing="0.1"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tv_mode_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MODE: STANDBY"
                android:textColor="#4400F5FF"
                android:textSize="8sp"
                android:letterSpacing="0.08"
                android:fontFamily="monospace"
                android:layout_marginTop="1dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Top Bar Separator Line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_gravity="top"
        android:layout_marginTop="56dp"
        android:background="@drawable/gradient_line_cyan" />

    <!--═════════════════════════════════════════════════════════════════════-->
    <!-- HUD METRICS GROUP: Quality + Readiness — компактный блок под баром -->
    <!-- Во время сканирования уезжает вверх и тускнеет                      -->
    <!--═════════════════════════════════════════════════════════════════════-->
    <LinearLayout
        android:id="@+id/ll_hud_metrics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="57dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="2dp"
        android:background="#AA050A0F">

        <!-- Quality Row -->
        <LinearLayout
            android:id="@+id/quality_bar"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:text="QUALITY"
                android:textColor="#6600F5FF"
                android:textSize="9sp"
                android:fontFamily="monospace" />

            <ProgressBar
                android:id="@+id/pb_quality"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="0"
                android:indeterminate="false" />

            <TextView
                android:id="@+id/tv_quality"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="#FF00F5FF"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:gravity="end"
                android:layout_marginStart="8dp" />
        </LinearLayout>


        <!-- Readiness Row -->
        <LinearLayout
            android:id="@+id/readiness_bar"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:text="READINESS"
                android:textColor="#6600F5FF"
                android:textSize="9sp"
                android:fontFamily="monospace" />

            <ProgressBar
                android:id="@+id/pb_readiness"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="0"
                android:indeterminate="false" />

            <TextView
                android:id="@+id/tv_readiness"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="#FF00F5FF"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:gravity="end"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Detail + Coach row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_readiness_detail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="OBS 0%/0% | VDIV 0/0 | VP 0/0"
                android:textColor="#5500F5FF"
                android:textSize="7sp"
                android:fontFamily="monospace"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_scan_coach"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text=""
                android:textColor="#DDFF9900"
                android:textSize="8sp"
                android:fontFamily="monospace"
                android:gravity="end"
                android:singleLine="true"
                android:ellipsize="end"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- MODE INDICATOR -->
    <LinearLayout
        android:id="@+id/mode_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="130dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/mode_edit_bg"
        android:visibility="gone">

        <TextView
            android:id="@+id/mode_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="✏️"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/mode_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Режим редактирования"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Undo/Redo Panel -->
    <LinearLayout
        android:id="@+id/undo_redo_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="224dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/btn_undo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:enabled="false"
            android:text="↶"
            android:textSize="18sp"
            android:background="@drawable/btn_icon_cyan"
            android:stateListAnimator="@null"
            android:elevation="0dp" />

        <Button
            android:id="@+id/btn_redo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:enabled="false"
            android:text="↷"
            android:textSize="18sp"
            android:background="@drawable/btn_icon_cyan"
            android:stateListAnimator="@null"
            android:elevation="0dp" />
    </LinearLayout>

    <!--═════════════════════════════════════════════════════════════════════-->
    <!-- CORNER FRAME (Инженерные углы) -->
    <!--═════════════════════════════════════════════════════════════════════-->

    <!-- Top-Left -->
    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="70dp"
        android:src="@drawable/ic_corner_tl_cyan"
        android:scaleType="fitXY" />

    <!-- Top-Right -->
    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="70dp"
        android:src="@drawable/ic_corner_tr_cyan"
        android:scaleType="fitXY" />

    <!-- Bottom-Left -->
    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="236dp"
        android:src="@drawable/ic_corner_bl_cyan"
        android:scaleType="fitXY" />

    <!-- Bottom-Right -->
    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="236dp"
        android:src="@drawable/ic_corner_br_cyan"
        android:scaleType="fitXY" />

    <!--═════════════════════════════════════════════════════════════════════-->
    <!-- SMART RETICLE — живой AR-прицел с обратной связью                  -->
    <!-- GREEN=плоскость найдена / YELLOW=feature point / DIM=поиск         -->
    <!-- Форма овала отражает наклон поверхности (пол=плоский, стена=круг)  -->
    <!-- Tap по прицелу = поставить якорь (tap-to-place)                    -->
    <!--═════════════════════════════════════════════════════════════════════-->
    <com.example.aibrain.SmartReticleView
        android:id="@+id/smart_reticle"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_gravity="center"
        android:contentDescription="Нажмите для размещения якоря" />

    <!--═════════════════════════════════════════════════════════════════════-->
    <!-- LEFT SIDEBAR DATA -->
    <!--═════════════════════════════════════════════════════════════════════-->
    <LinearLayout
        android:id="@+id/ll_coords_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="12dp"
        android:orientation="vertical"
        android:background="@drawable/bg_data_panel"
        android:padding="10dp"
        android:alpha="0.85">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▸ COORDINATES"
            android:textColor="#6600F5FF"
            android:textSize="8sp"
            android:letterSpacing="0.15"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_coord_x"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="X: 0.00"
            android:textColor="#FF00F5FF"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tv_coord_y"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Y: 0.00"
            android:textColor="#FF00F5FF"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tv_coord_z"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Z: 0.00"
            android:textColor="#FF00F5FF"
            android:textSize="11sp"
            android:fontFamily="monospace" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#3300F5FF"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▸ ANCHORS"
            android:textColor="#6600F5FF"
            android:textSize="8sp"
            android:letterSpacing="0.15"
            android:fontFamily="monospace"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tv_points_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PTS: 0"
            android:textColor="#FF00FF88"
            android:textSize="11sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!--═════════════════════════════════════════════════════════════════════-->
    <!-- RIGHT SIDEBAR STATUS -->
    <!--═════════════════════════════════════════════════════════════════════-->
    <LinearLayout
        android:id="@+id/ll_status_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="12dp"
        android:orientation="vertical"
        android:background="@drawable/bg_data_panel"
        android:padding="10dp"
        android:alpha="0.85">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▸ STATUS"
            android:textColor="#6600F5FF"
            android:textSize="8sp"
            android:letterSpacing="0.15"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/ic_dot_green"
                android:layout_marginEnd="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AR TRACKING"
                android:textColor="#FF00FF88"
                android:textSize="9sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <View
                android:id="@+id/connection_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/ic_dot_orange"
                android:layout_marginEnd="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI SERVER"
                android:textColor="#FFFF8C42"
                android:textSize="9sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/ic_dot_cyan"
                android:layout_marginEnd="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SCANNING"
                android:textColor="#FF00F5FF"
                android:textSize="9sp"
                android:fontFamily="monospace" />
        </LinearLayout>
    </LinearLayout>

    <!--═════════════════════════════════════════════════════════════════════-->
    <!-- BOTTOM CONTROL PANEL -->
    <!--═════════════════════════════════════════════════════════════════════-->
    <LinearLayout
        android:id="@+id/control_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_control_panel"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp"
        android:elevation="12dp">

        <!-- Panel Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▸ CONTROL INTERFACE"
                android:textColor="#6600F5FF"
                android:textSize="9sp"
                android:letterSpacing="0.2"
                android:fontFamily="monospace" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/gradient_line_cyan_fade" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v3.0"
                android:textColor="#4400F5FF"
                android:textSize="9sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- AI Hint Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_hint_box"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#FF00F5FF"
                android:textSize="20sp"
                android:layout_marginEnd="10dp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tv_ai_hint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Наведите камеру на конструкцию и нажмите СТАРТ"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- Main Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btn_start"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="▸ СТАРТ"
                android:textColor="#FF050A0F"
                android:textSize="13sp"
                android:letterSpacing="0.15"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:background="@drawable/btn_primary_cyan"
                android:stateListAnimator="@null"
                android:elevation="0dp" />

            <Button
                android:id="@+id/btn_add_point"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.2"
                android:layout_marginEnd="6dp"
                android:text="ОПОРА"
                android:textColor="#FF00F5FF"
                android:textSize="12sp"
                android:letterSpacing="0.12"
                android:fontFamily="monospace"
                android:background="@drawable/btn_secondary_cyan"
                android:stateListAnimator="@null"
                android:elevation="0dp"
                android:visibility="visible" />

            <Button
                android:id="@+id/btn_add_waypoint"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.2"
                android:layout_marginEnd="6dp"
                android:text="ТОЧКА"
                android:textColor="#FF00F5FF"
                android:textSize="12sp"
                android:letterSpacing="0.12"
                android:fontFamily="monospace"
                android:background="@drawable/btn_secondary_cyan"
                android:stateListAnimator="@null"
                android:elevation="0dp"
                android:visibility="visible" />

            <Button
                android:id="@+id/btn_scan"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="СКАН"
                android:textColor="#FF00F5FF"
                android:textSize="12sp"
                android:letterSpacing="0.12"
                android:fontFamily="monospace"
                android:background="@drawable/btn_secondary_cyan"
                android:stateListAnimator="@null"
                android:elevation="0dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_3d_model"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.3"
                android:layout_marginEnd="6dp"
                android:text="3D MODEL"
                android:textColor="#FFFF8C42"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:fontFamily="monospace"
                android:background="@drawable/btn_tertiary_orange"
                android:stateListAnimator="@null"
                android:elevation="0dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_analyze"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.3"
                android:text="АНАЛИЗ"
                android:textColor="#FF050A0F"
                android:textSize="12sp"
                android:letterSpacing="0.12"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:background="@drawable/btn_primary_green"
                android:stateListAnimator="@null"
                android:elevation="0dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Secondary Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btn_save_session"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="💾"
                android:textSize="16sp"
                android:background="@drawable/btn_icon_cyan"
                android:stateListAnimator="@null"
                android:elevation="0dp" />

            <Button
                android:id="@+id/btn_export"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="📦"
                android:textSize="16sp"
                android:background="@drawable/btn_icon_cyan"
                android:stateListAnimator="@null"
                android:elevation="0dp" />

            <Button
                android:id="@+id/btn_settings"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="⚙️"
                android:textSize="16sp"
                android:background="@drawable/btn_icon_cyan"
                android:stateListAnimator="@null"
                android:elevation="0dp" />

            <Button
                android:id="@+id/btn_ruler_mode"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Рулетка"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:background="@drawable/btn_icon_cyan"
                android:stateListAnimator="@null"
                android:elevation="0dp" />
        </LinearLayout>
    </LinearLayout>

    <!--═════════════════════════════════════════════════════════════════════-->
    <!-- VARIANT SELECTION PANEL (Initially Hidden) -->
    <!--═════════════════════════════════════════════════════════════════════-->
    <LinearLayout
        android:id="@+id/variant_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_variant_panel"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp"
        android:elevation="12dp"
        android:visibility="gone">

        <!-- Panel Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▸ ВЫБОР ВАРИАНТА КОНСТРУКЦИИ"
            android:textColor="#FFFF8C42"
            android:textSize="11sp"
            android:letterSpacing="0.2"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tv_ai_critique"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#E6FFFFFF"
            android:textSize="12sp"
            android:layout_marginBottom="14dp"
            android:lineSpacingExtra="2dp"
            android:visibility="gone" />

        <!-- Variants List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_variants"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:overScrollMode="never"
            android:scrollbars="none" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_physics"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="📊 ФИЗИКА"
                android:textColor="#FFFF8C42"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:background="@drawable/btn_secondary_orange"
                android:stateListAnimator="@null"
                android:elevation="0dp" />

            <Button
                android:id="@+id/btn_accept"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.5"
                android:text="✓ ПРИНЯТЬ"
                android:textColor="#FF050A0F"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:background="@drawable/btn_primary_green"
                android:stateListAnimator="@null"
                android:elevation="0dp" />
        </LinearLayout>
    </LinearLayout>



    <!-- Eye of AI -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_eye_of_ai"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="236dp"
        android:contentDescription="Показать глаз ИИ"
        android:src="@drawable/ic_eye"
        app:backgroundTint="#FF00BCD4"
        app:tint="@android:color/white" />

    <LinearLayout
        android:id="@+id/voxel_legend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="80dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/legend_bg"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="👁️ Глаз ИИ"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="🔴 Препятствия"
            android:textColor="@android:color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="🔵 Существующие леса"
            android:textColor="@android:color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="🟢 Доступно для стройки"
            android:textColor="@android:color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🟡 Запретные зоны"
            android:textColor="@android:color/white" />
    </LinearLayout>

    <!-- AR Ruler overlay (offline-ready) -->
    <include
        layout="@layout/ruler_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
